<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Common Values — one chart a week on Europe’s progress" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="One carefully reported chart about European progress, trade-offs and shortcomings, published every week.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png" sizes="32x32">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <meta name="theme-color" content="<%= content_for(:theme_color) || "#f3efe5" %>">

    <link rel="preload" href="<%= asset_path("instrument-serif-roman-latin.woff2") %>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<%= asset_path("public-sans-roman-latin-v21.woff2") %>" as="font" type="font/woff2" crossorigin>

    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

<body class="<%= content_for(:body_class) %>">
  <a class="skip-link" href="#main-content">Skip to content</a>

  <% if content_for(:body_class).to_s.include?("edition-page") %>
    <div class="reading-progress" aria-hidden="true" data-controller="reading-progress">
      <div class="reading-progress-bar" data-reading-progress-target="bar"></div>
    </div>
  <% end %>

  <%
    nav_current = if request.path == "/"
                     "latest"
                   elsif request.path.start_with?("/editions")
                     "archive"
                   elsif request.path.start_with?("/statistics")
                     "library"
                   elsif request.path.start_with?("/methodology")
                     "method"
                   end
    nav_aria = ->(section) { nav_current == section ? { current: "page" } : {} }
  %>

  <header class="site-header" data-controller="mobile-menu">
    <div class="masthead">
      <p class="masthead-note">
        <span>One chart a week on Europe’s progress</span>
        <span>Progress when the evidence shows it</span>
        <span>Problems when it doesn’t</span>
      </p>

      <%= link_to root_path, class: "wordmark", aria: { label: "Common Values, home" } do %>
        <span>Common Values</span>
      <% end %>

      <div class="masthead-actions">
        <%= link_to "Method", methodology_path %>
        <% substack_url = ENV.fetch("SUBSTACK_PUBLICATION_URL", editions_path) %>
        <a class="nav-subscribe" href="<%= substack_url %>">Subscribe <span class="link-arrow" aria-hidden="true">→</span></a>
      </div>

      <button class="nav-toggle" data-action="click->mobile-menu#toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span>
      </button>
    </div>

    <nav class="mobile-nav hidden" id="mobile-nav" data-mobile-menu-target="menu" aria-label="Mobile navigation">
      <%= link_to "Latest", root_path %>
      <%= link_to "Archive", editions_path %>
      <%= link_to "Data library", statistics_path %>
      <%= link_to "Method", methodology_path %>
      <a href="<%= ENV.fetch("SUBSTACK_PUBLICATION_URL", editions_path) %>">Subscribe</a>
    </nav>
  </header>

  <nav class="primary-nav" aria-label="Primary navigation">
    <div>
      <%= link_to "Latest", root_path, aria: nav_aria.call("latest") %>
      <%= link_to "Archive", editions_path, aria: nav_aria.call("archive") %>
      <%= link_to "Data library", statistics_path, aria: nav_aria.call("library") %>
      <%= link_to "Method", methodology_path, aria: nav_aria.call("method") %>
    </div>
  </nav>

  <main id="main-content">
    <% if flash[:alert] %><p class="flash-message"><%= flash[:alert] %></p><% end %>
    <%= yield %>
  </main>

  <footer class="site-footer">
    <div class="page-shell">
      <p class="footer-wordmark">Common Values</p>

      <div class="footer-mid">
        <p class="footer-tagline">Progress when the evidence shows it. Problems when it doesn’t.</p>
        <nav class="footer-groups" aria-label="Footer navigation">
          <div class="footer-group">
            <h2>Read</h2>
            <%= link_to "Latest chart", root_path %>
            <%= link_to "Archive", editions_path %>
            <%= link_to "Fact checks", facts_path %>
          </div>
          <div class="footer-group">
            <h2>Method and data</h2>
            <%= link_to "Method", methodology_path %>
            <%= link_to "Data library", statistics_path %>
          </div>
          <div class="footer-group">
            <h2>Project</h2>
            <a href="<%= ENV.fetch("SUBSTACK_PUBLICATION_URL", editions_path) %>">Subscribe on Substack</a>
            <a href="https://github.com/Duartemartins/europe_versus">Open source</a>
          </div>
        </nav>
      </div>

      <div class="footer-colophon">
        <p>© <%= Date.current.year %> Common Values · One chart every Friday</p>
        <p>Data from official European and international statistics</p>
      </div>
    </div>
  </footer>
</body>
</html>
