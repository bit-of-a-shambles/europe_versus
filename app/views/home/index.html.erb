<%
  design_options = {
    "review" => { label: "Weekly review", theme_color: "#f3efe5" },
    "graphic" => { label: "Graphic detail", theme_color: "#ffffff" },
    "atlas" => { label: "Data note", theme_color: "#183a5a" }
  }
  design_key = design_options.key?(params[:design]) ? params[:design] : "review"
  design = design_options[design_key]
  body_classes = [ "headline-home-template", ("design-#{design_key}" if design_key) ].compact.join(" ")
%>
<% content_for :title, "#{@edition.title} — Common Values" %>
<% content_for :body_class, body_classes %>
<% content_for :theme_color, design ? design.fetch(:theme_color) : "#f3efe5" %>
<% content_for :head do %>
  <link rel="canonical" href="<%= edition_url(@edition.slug) %>">
  <meta property="og:title" content="<%= @edition.title %>">
  <meta property="og:description" content="<%= @edition.dek %>">
  <meta property="og:type" content="article">
  <meta property="og:image" content="<%= edition_chart_image_url(@edition.slug) %>">
  <meta name="twitter:card" content="summary_large_image">
<% end %>

<div class="headline-home page-shell">
  <section class="headline-latest" aria-labelledby="latest-heading">
    <p id="latest-heading" class="headline-section-name"><%= design ? design.fetch(:label) : "Latest" %></p>

    <article class="headline-lead">
      <div class="headline-lead-chart">
        <%= render "home/lead_chart", edition: @edition, chart: @chart %>
      </div>

      <% if @chart.gap %>
        <div class="headline-finding" aria-label="Key finding: <%= @chart.gap.fetch(:label) %>">
          <strong><%= @chart.gap.fetch(:label) %></strong>
          <span>Italy–Poland productivity gap since <%= @chart.start_year %></span>
        </div>
      <% end %>

      <div class="headline-lead-copy">
        <div class="headline-meta">
          <span><%= @edition.category %></span>
          <time datetime="<%= @edition.published_at.iso8601 %>"><%= @edition.published_at.strftime("%d %B %Y") %></time>
        </div>
        <h1><%= link_to @edition.title, edition_path(@edition.slug) %></h1>
        <p class="headline-dek"><%= @edition.dek %></p>
        <p class="headline-byline">Common Values · Issue <%= @edition.issue_number.to_s.rjust(2, "0") %></p>
        <%= link_to edition_path(@edition.slug), class: "headline-read-link" do %>Read the evidence <span class="link-arrow" aria-hidden="true">→</span><% end %>
      </div>
    </article>

    <dl class="headline-data-strip">
      <div>
        <dt>Geography</dt>
        <dd><%= @edition.geography %></dd>
      </div>
      <div>
        <dt>Period</dt>
        <dd><%= @chart.period_label %></dd>
      </div>
      <div>
        <dt>Source</dt>
        <dd><%= @edition.source.fetch("name").split(" — ").first %></dd>
      </div>
    </dl>

    <div class="headline-evidence">
      <p><strong>Source and method.</strong> <a href="<%= @edition.source.fetch("url") %>"><%= @edition.source.fetch("name") %></a>. <%= @edition.methodology %></p>
      <%= link_to "Full methodology", edition_path(@edition.slug, anchor: "source-heading") %>
    </div>
  </section>

  <% if @archive.any? %>
    <section class="headline-archive" aria-labelledby="earlier-heading">
      <div class="headline-section-header">
        <h2 id="earlier-heading">Earlier charts</h2>
        <%= link_to "View the archive", editions_path %>
      </div>

      <ol class="headline-story-list" data-controller="scroll-reveal">
        <% @archive.each do |edition| %>
          <li data-scroll-reveal-target="item">
            <%= link_to edition_path(edition.slug) do %>
              <span class="headline-story-number"><%= edition.issue_number.to_s.rjust(2, "0") %></span>
              <span class="headline-story-copy">
                <strong><%= edition.title %></strong>
                <span><%= edition.category %> · <%= edition.published_at.strftime("%d %b %Y") %></span>
              </span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

</div>

<section class="headline-subscribe" aria-labelledby="subscribe-heading">
  <div class="page-shell headline-subscribe-inner">
    <div>
      <p>One chart every Friday</p>
      <h2 id="subscribe-heading">Evidence about Europe, without the victory lap or the doom loop.</h2>
    </div>
    <% substack_url = ENV.fetch("SUBSTACK_PUBLICATION_URL", editions_path) %>
    <a class="subscribe-cta" href="<%= substack_url %>"><span class="gradient-text--paper" data-controller="gradient-text">Subscribe on Substack</span> <span class="link-arrow" aria-hidden="true">→</span></a>
  </div>
</section>
