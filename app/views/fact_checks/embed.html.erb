<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= @fact_check.title %> — Common Values</title>
  
  <!-- Minimal styles for embed -->
  <style>
    @font-face { font-family: "Besley"; font-style: normal; font-weight: 400 700; font-display: swap; src: url("<%= asset_path("besley-roman-latin-ext-v22.woff2") %>") format("woff2"); }
    @font-face { font-family: "Besley"; font-style: normal; font-weight: 400 700; font-display: swap; src: url("<%= asset_path("besley-roman-latin-v22.woff2") %>") format("woff2"); }
    @font-face { font-family: "Besley"; font-style: italic; font-weight: 400; font-display: swap; src: url("<%= asset_path("besley-italic-latin-ext-v22.woff2") %>") format("woff2"); }
    @font-face { font-family: "Besley"; font-style: italic; font-weight: 400; font-display: swap; src: url("<%= asset_path("besley-italic-latin-v22.woff2") %>") format("woff2"); }
    @font-face { font-family: "Public Sans"; font-style: normal; font-weight: 400 700; font-display: swap; src: url("<%= asset_path("public-sans-roman-latin-ext-v21.woff2") %>") format("woff2"); }
    @font-face { font-family: "Public Sans"; font-style: normal; font-weight: 400 700; font-display: swap; src: url("<%= asset_path("public-sans-roman-latin-v21.woff2") %>") format("woff2"); }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: "Public Sans", "Helvetica Neue", Arial, sans-serif;
      background: white;
      padding: 0;
      margin: 0;
    }
    
    .font-mono {
      font-family: "Public Sans", "Helvetica Neue", Arial, sans-serif;
    }
    
    .card {
      border: 3px solid #000;
      background: white;
      min-height: 100%;
    }
    
    .card-header {
      padding: 16px 20px;
      border-bottom: 3px solid #000;
    }
    
    .badge {
      background: #71394D;
      color: white;
      padding: 4px 8px;
      font-size: 10px;
      font-weight: 600;
      display: inline-block;
      margin-bottom: 8px;
    }
    
    .title {
      font-family: "Besley", Georgia, serif;
      font-size: 18px;
      font-weight: 500;
      line-height: 1.2;
    }
    
    .subtitle {
      font-family: "Besley", Georgia, serif;
      font-size: 14px;
      color: rgba(0,0,0,0.6);
      font-style: italic;
      margin-top: 8px;
    }
    
    .card-body {
      padding: 16px 20px;
    }
    
    .description {
      font-size: 14px;
      line-height: 1.5;
      color: rgba(0,0,0,0.8);
    }
    
    .metrics {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 12px;
    }
    
    .metric-tag {
      font-size: 10px;
      padding: 4px 8px;
      border: 1px solid rgba(0,0,0,0.2);
    }
    
    .card-footer {
      padding: 12px 20px;
      border-top: 2px solid #000;
      background: #E8E0D3;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .read-more {
      font-size: 12px;
      color: #71394D;
      text-decoration: none;
    }
    
    .read-more:hover {
      text-decoration: underline;
    }
    
    .brand {
      font-size: 11px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="card-header">
      <span class="badge font-mono">Fact Check</span>
      <h1 class="title"><%= @fact_check.title %></h1>
      <% if @fact_check.subtitle %>
        <p class="subtitle">"<%= @fact_check.subtitle %>"</p>
      <% end %>
    </div>
    
    <div class="card-body">
      <% if @fact_check.description %>
        <p class="description">
          <%= truncate(@fact_check.description, length: 200) %>
        </p>
      <% end %>
      
      <% if @fact_check.metrics.any? %>
        <div class="metrics">
          <% @fact_check.metrics.first(5).each do |metric| %>
            <span class="metric-tag font-mono"><%= metric.tr("_", " ").titleize %></span>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <div class="card-footer">
      <a href="<%= fact_check_url(slug: @fact_check.slug) %>" target="_blank" class="read-more font-mono">
        Read full analysis →
      </a>
      <span class="brand font-mono">Common Values</span>
    </div>
  </div>
</body>
</html>
