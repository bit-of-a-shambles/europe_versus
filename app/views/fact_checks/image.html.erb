<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    @font-face { font-family: "Instrument Serif"; font-style: normal; font-weight: 400; src: url("<%= embedded_brand_font(:instrument_serif_roman_latin_ext) %>") format("woff2"); }
    @font-face { font-family: "Instrument Serif"; font-style: normal; font-weight: 400; src: url("<%= embedded_brand_font(:instrument_serif_roman_latin) %>") format("woff2"); }
    @font-face { font-family: "Instrument Serif"; font-style: italic; font-weight: 400; src: url("<%= embedded_brand_font(:instrument_serif_italic_latin_ext) %>") format("woff2"); }
    @font-face { font-family: "Instrument Serif"; font-style: italic; font-weight: 400; src: url("<%= embedded_brand_font(:instrument_serif_italic_latin) %>") format("woff2"); }
    @font-face { font-family: "Public Sans"; font-style: normal; font-weight: 400; src: url("<%= embedded_brand_font(:public_sans_roman_latin_ext) %>") format("woff2"); }
    @font-face { font-family: "Public Sans"; font-style: normal; font-weight: 400; src: url("<%= embedded_brand_font(:public_sans_roman_latin) %>") format("woff2"); }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: "Public Sans", "Helvetica Neue", Arial, sans-serif;
      background: #F3EFE5;
      width: 1200px;
      height: 630px;
      overflow: hidden;
    }
    
    .font-mono {
      font-family: "Public Sans", "Helvetica Neue", Arial, sans-serif;
    }
    
    .card {
      width: 1200px;
      height: 630px;
      border: 6px solid #000;
      background: #F3EFE5;
      display: flex;
      flex-direction: column;
    }
    
    .card-header {
      padding: 48px;
      border-bottom: 6px solid #000;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    
    .badge {
      display: inline-block;
      background: #71394D;
      color: white;
      padding: 8px 16px;
      font-family: "Public Sans", "Helvetica Neue", Arial, sans-serif;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 24px;
    }
    
    .title {
      font-family: "Instrument Serif", Georgia, serif;
      font-size: 56px;
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
      max-width: 900px;
    }
    
    .subtitle {
      font-family: "Instrument Serif", Georgia, serif;
      font-size: 28px;
      color: rgba(0,0,0,0.6);
      font-style: italic;
      max-width: 800px;
    }
    
    .card-footer {
      padding: 32px 48px;
      background: #E8E0D3;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .metrics {
      display: flex;
      gap: 12px;
    }
    
    .metric-tag {
      font-family: "Public Sans", "Helvetica Neue", Arial, sans-serif;
      font-size: 12px;
      padding: 6px 12px;
      border: 1px solid rgba(0,0,0,0.2);
    }
    
    .brand {
      font-family: "Instrument Serif", Georgia, serif;
      font-size: 24px;
      font-weight: 400;
      color: #000;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="card-header">
      <span class="badge">Fact Check</span>
      <h1 class="title"><%= fact_check.title %></h1>
      <% if fact_check.subtitle %>
        <p class="subtitle">"<%= fact_check.subtitle %>"</p>
      <% end %>
    </div>
    
    <div class="card-footer">
      <div class="metrics">
        <% fact_check.metrics.first(4).each do |metric| %>
          <span class="metric-tag"><%= metric.tr("_", " ").split.first(2).join(" ") %></span>
        <% end %>
        <% if fact_check.metrics.size > 4 %>
          <span class="metric-tag">+<%= fact_check.metrics.size - 4 %> more</span>
        <% end %>
      </div>
      <span class="brand">Common Values</span>
    </div>
  </div>
</body>
</html>
