<% content_for :title, "Data library — Common Values" %>

<header class="library-header page-shell">
  <p class="kicker">Data library</p>
  <h1>The numbers behind the stories.</h1>
  <p>Comparable European indicators, with the source, year and geographic coverage kept visible.</p>
</header>

<% if @statistics.any? %>
  <nav class="library-nav page-shell" data-controller="library-nav" aria-label="Data categories">
    <% @statistics.keys.each do |category| %>
      <%= link_to category.humanize, "#category-#{category}" %>
    <% end %>
  </nav>

  <div class="library page-shell">
    <% @statistics.each do |category, stats| %>
      <section id="category-<%= category %>" class="library-section">
        <header class="library-section-header">
          <h2><%= category.humanize %></h2>
          <span><%= pluralize(stats.size, "metric") %></span>
        </header>

        <ol class="metric-list">
          <% stats.each do |stat| %>
            <li>
              <%= link_to statistic_path(stat.id), class: "metric-row" do %>
                <div class="metric-name">
                  <h3><%= stat.metric %></h3>
                  <p><%= stat.source.present? ? stat.source : "Source available on detail page" %></p>
                </div>
                <div class="metric-value metric-value-europe">
                  <span>Europe</span>
                  <strong><%= stat.europe_value.present? ? format_value_with_unit(stat.europe_value, stat.unit, decimals: 2) : "—" %></strong>
                </div>
                <div class="metric-comparison">
                  <% if stat.us_value.present? %><span>US <b><%= format_value_with_unit(stat.us_value, stat.unit, decimals: 2) %></b></span><% end %>
                  <% if stat.china_value.present? %><span>China <b><%= format_value_with_unit(stat.china_value, stat.unit, decimals: 2) %></b></span><% end %>
                  <% if stat.india_value.present? %><span>India <b><%= format_value_with_unit(stat.india_value, stat.unit, decimals: 2) %></b></span><% end %>
                </div>
                <time><%= stat.year %></time>
                <span class="metric-arrow" aria-hidden="true">→</span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>
  </div>
<% else %>
  <section class="library-empty page-shell">
    <h2>No datasets yet</h2>
    <p>The first verified comparisons will appear here.</p>
  </section>
<% end %>

<section class="library-method page-shell">
  <div>
    <p class="kicker">How we work</p>
    <h2>Every aggregate needs the right denominator.</h2>
  </div>
  <div>
    <p>Per-person measures use population weights. Totals are summed. Rates based on hours, workers or energy use their underlying quantity. Each edition discloses the exact method.</p>
    <%= link_to "Read the methodology →", methodology_path %>
  </div>
</section>
